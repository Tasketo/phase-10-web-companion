{
  "name": "phase-10-web-companion",
  "version": "0.1.0",
  "author": "tasketo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:e2e": "rm -rf .nyc_output && playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "coverage:merge": "nyc merge .nyc_output .nyc_output/coverage-final.json",
    "coverage:report": "nyc report --reporter=html --report-dir=.nyc_output/html --temp-dir=.nyc_output",
    "coverage:html": "npm run coverage:merge && npm run coverage:report"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "primeicons": "^8.0.0",
    "primereact": "^10.9.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "istanbul-reports": "^3.2.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "overrides": {
    "uuid": "^14.0.0"
  }
}
